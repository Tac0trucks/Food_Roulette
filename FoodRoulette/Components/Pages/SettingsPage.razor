@page "/settings"
@inject FoodRouletteApp.Models.AppState State
@inject NavigationManager Nav

<div style="min-height: 100vh;">
    <!-- Top Nav -->
    <header class="navbar-container">
        <a href="/" style="display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--color-ink);">
            <span style="width: 36px; height: 36px; border-radius: 10px; background: var(--color-ink); color: #fff; display: grid; place-items: center;"><Icons Name="dice" /></span>
            <span style="font-size: 19px; font-weight: 800;">FoodRoulette</span>
        </a>
        <a href="/" style="font-size: 14px; font-weight: 600; color: var(--color-stone); text-decoration: none;">← Back to Dashboard</a>
    </header>

    <main style="max-width: 1100px; margin: 0 auto; padding: 24px 32px 40px; display: grid; grid-template-columns: 240px 1fr; gap: 24px;">
        <!-- Left Sub-Nav -->
        <aside class="card" style="padding: 16px; height: fit-content;">
            <p class="font-mono" style="font-size: 11px; text-transform: uppercase; color: var(--color-stone); padding: 8px 12px;">Account Hub</p>
            <div style="display: flex; flex-direction: column; gap: 4px;">
                <button @onclick='() => Nav.NavigateTo("/profile")' style="padding: 10px 12px; border-radius: 8px; text-align: left; font-size: 14px; font-weight: 500; color: var(--color-stone);">Profile</button>
                <button style="padding: 10px 12px; border-radius: 8px; text-align: left; font-size: 14px; font-weight: 700; background: var(--color-matcha-wash); color: var(--color-matcha-deep);">Settings & Preferences</button>
                <div style="height: 1px; background: var(--color-line); margin: 8px 0;"></div>
                <button @onclick="Logout" style="padding: 10px 12px; border-radius: 8px; text-align: left; font-size: 14px; font-weight: 500; color: #DC2626;">Sign Out</button>
            </div>
        </aside>

        <!-- Right Content -->
        <div style="display: flex; flex-direction: column; gap: 24px;">
            <div>
                <h1 class="font-serif" style="font-size: 36px; font-weight: 500;">Roulette <em style="font-style: italic;">Preferences</em></h1>
                <p style="font-size: 15px; color: var(--color-stone);">Set default behavior, dietary exclusions, and manage history.</p>
            </div>

            <!-- Dietary Restrictions -->
            <section class="card" style="padding: 28px; border-left: 4px solid var(--color-sage);">
                <h3 class="font-serif" style="font-size: 24px; font-weight: 500;">Dietary <em style="font-style: italic;">Restrictions</em></h3>
                <p style="font-size: 14px; color: var(--color-stone); margin-bottom: 16px;">These will always be excluded from your roulette pool.</p>
                <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                    @foreach (var d in new[] { "Vegetarian", "Halal", "Nut Allergy", "Dairy-Free", "Pescatarian", "Gluten-Free" })
                    {
                        var on = State.DietaryRestrictions.Contains(d);
                        <button class="pill-btn @(on ? "active-subtle" : "")" style="height: 36px; padding: 0 14px;" @onclick="() => ToggleDiet(d)">
                            @if (on) { <Icons Name="check" /> } @d
                        </button>
                    }
                </div>
            </section>

            <!-- Default Starting Filters -->
            <section class="card" style="padding: 28px;">
                <h3 class="font-serif" style="font-size: 24px; font-weight: 500; margin-bottom: 20px;">Default <em style="font-style: italic;">Dashboard</em> State</h3>
                
                <div style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 14px; font-weight: 600; margin-bottom: 8px;">Default Budget</label>
                    <div style="display: grid; grid-template-columns: repeat(3, 100px); gap: 8px;">
                        @for (int b = 1; b <= 3; b++)
                        {
                            var val = b;
                            <button class="pill-btn @(State.DefaultBudget == val ? "active" : "") font-mono" style="height: 40px; justify-content: center;" @onclick="() => State.DefaultBudget = val">
                                @(new string('$', val))
                            </button>
                        }
                    </div>
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 14px; font-weight: 600; margin-bottom: 8px;">Max Search Distance: @State.MaxRadiusKm km</label>
                    <input type="range" min="1" max="20" class="range-slider" style="width: 320px;" @bind="State.MaxRadiusKm" @bind:event="oninput" />
                </div>

                <div style="display: flex; align-items: center; justify-content: space-between; max-width: 420px; border: 1px solid var(--color-line); padding: 12px 16px; border-radius: 12px;">
                    <span style="font-size: 14px; font-weight: 500;"><Icons Name="flame" /> Always exclude spicy food by default</span>
                    <div class="switch-track @(State.ExcludeSpicyDefault ? "on" : "")" @onclick="() => State.ExcludeSpicyDefault = !State.ExcludeSpicyDefault">
                        <div class="switch-thumb"></div>
                    </div>
                </div>
            </section>
        </div>
    </main>
</div>

@code {
    private void ToggleDiet(string d)
    {
        if (State.DietaryRestrictions.Contains(d)) State.DietaryRestrictions.Remove(d);
        else State.DietaryRestrictions.Add(d);
    }

    private void Logout()
    {
        State.IsAuthenticated = false;
        Nav.NavigateTo("/auth");
    }
}