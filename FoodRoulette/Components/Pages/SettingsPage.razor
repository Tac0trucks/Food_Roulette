@page "/settings"
@rendermode InteractiveServer
@inject FoodRouletteApp.Models.AppState State
@inject NavigationManager Nav

<div class="min-h-screen bg-paper bg-[radial-gradient(1200px_600px_at_85%_-10%,#E6F1E8_0%,transparent_60%),radial-gradient(800px_500px_at_-10%_110%,#FDEBDB_0%,transparent_55%)]">
    <!-- Top Nav -->
    <header class="mx-auto flex h-[76px] max-w-[1440px] items-center justify-between px-4 sm:px-8">
        <div class="flex items-center gap-5">
            <a href="/" class="flex items-center gap-2.5 text-ink">
                <span class="grid size-9 place-items-center rounded-[10px] bg-ink text-white"><Icons Name="dice" /></span>
                <span class="text-[19px] font-extrabold tracking-[-0.02em]">FoodRoulette</span>
            </a>
            <span class="hidden h-5 w-px bg-line sm:block"></span>
            <a href="/" class="hidden items-center gap-1.5 text-sm font-semibold text-stone transition hover:text-matcha sm:flex">
                ← Back to Dashboard
            </a>
        </div>
        <a href="/profile" class="flex h-10 items-center gap-2 rounded-full border border-line bg-white py-1 pl-1 pr-3 transition hover:border-stone/40">
            <span class="grid size-8 place-items-center rounded-full bg-matcha text-xs font-bold text-white">@State.Initials</span>
            <span class="text-sm font-semibold text-ink">@State.DisplayName</span>
        </a>
    </header>

    <!-- Main Workspace -->
    <main class="mx-auto grid max-w-[1100px] gap-6 px-4 pb-10 pt-6 sm:px-8 lg:grid-cols-[240px_1fr] lg:px-0">
        <!-- Left Sub-Nav Rail -->
        <aside class="h-fit rounded-2xl border border-line bg-white p-4 shadow-card lg:sticky lg:top-6">
            <p class="px-3 pb-3 pt-1 font-mono text-[11px] uppercase tracking-[0.14em] text-stone">Account Hub</p>
            <nav class="flex flex-col gap-1">
                <a href="/profile" class="flex h-11 items-center gap-2.5 rounded-xl px-3 text-left text-sm font-medium text-stone hover:bg-paper hover:text-ink">
                    <Icons Name="user" /> Profile
                </a>
                <a href="/settings" class="relative flex h-11 items-center gap-2.5 rounded-xl bg-matcha-wash px-3 text-left text-sm font-bold text-matcha-deep">
                    <span class="absolute inset-y-2 left-0 w-[3px] rounded-full bg-matcha"></span>
                    <Icons Name="sliders" /> Settings & Preferences
                </a>
            </nav>
            <div class="my-3 h-px bg-line"></div>
            <button @onclick="Logout" class="flex h-11 w-full items-center gap-2.5 rounded-xl px-3 text-sm font-medium text-stone transition hover:bg-red-50 hover:text-red-700">
                Sign Out
            </button>
        </aside>

        <!-- Right Content Panels -->
        <div class="flex flex-col gap-6">
            <div>
                <h1 class="font-serif text-[36px] font-medium leading-[1.05] tracking-[-0.015em] text-ink">Roulette <em class="italic">Preferences</em></h1>
                <p class="mt-2 text-[15px] text-stone">Set default behavior, dietary exclusions, and manage history.</p>
            </div>

            <!-- Card 1: Dietary Restrictions -->
            <section class="relative overflow-hidden rounded-2xl border border-line bg-white p-7 shadow-card">
                <span class="absolute inset-y-0 left-0 w-1 bg-sage"></span>
                <div class="mb-5 flex items-start justify-between">
                    <div>
                        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-sage">Exclusion Rules</p>
                        <h2 class="mt-1 font-serif text-[24px] font-medium text-ink">Dietary <em class="italic">Restrictions</em></h2>
                        <p class="mt-1 text-sm text-stone">These will always be excluded from your roulette pool.</p>
                    </div>
                    <span class="rounded-full border border-sage/25 bg-sage-wash px-2.5 py-1 font-mono text-[11px] text-sage">@State.DietaryRestrictions.Count active</span>
                </div>
                <div class="flex flex-wrap gap-2">
                    @foreach (var d in new[] { "Vegetarian", "Halal", "Nut Allergy", "Dairy-Free", "Pescatarian", "Gluten-Free" })
                    {
                        var on = State.DietaryRestrictions.Contains(d);
                        <button class="flex h-9 items-center gap-1.5 rounded-full border px-3.5 text-[13px] font-medium transition @(on ? "border-sage/35 bg-sage-wash font-semibold text-matcha-deep" : "border-line text-ink hover:border-stone/50")"
                                @onclick="() => ToggleDiet(d)">
                            @if (on) { <Icons Name="check" /> } @d
                        </button>
                    }
                </div>
            </section>

            <!-- Card 2: Default Starting Filters -->
            <section class="rounded-2xl border border-line bg-white p-7 shadow-card">
                <div class="mb-6">
                    <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-matcha">Starting Filters</p>
                    <h2 class="mt-1 font-serif text-[24px] font-medium text-ink">Default <em class="italic">Dashboard</em> State</h2>
                    <p class="mt-1 text-sm text-stone">Starting filter settings applied when launching the app.</p>
                </div>

                <!-- Budget -->
                <div class="grid gap-3 border-t border-line py-5 first:border-t-0 first:pt-0 md:grid-cols-[220px_1fr] md:items-center">
                    <div>
                        <p class="text-[14px] font-semibold text-ink">Budget</p>
                        <p class="mt-0.5 text-[13px] text-stone">Typical spend per person</p>
                    </div>
                    <div class="grid max-w-[360px] grid-cols-3 gap-2">
                        @for (int b = 1; b <= 3; b++)
                        {
                            var val = b;
                            <button class="h-11 rounded-full border font-mono text-[15px] font-medium transition @(State.DefaultBudget == val ? "border-matcha bg-matcha text-white shadow-[0_4px_12px_rgba(21,128,61,.22)]" : "border-line text-ink hover:border-stone/50")"
                                    @onclick="() => State.DefaultBudget = val">
                                @(new string('$', val))
                            </button>
                        }
                    </div>
                </div>

                <!-- Radius -->
                <div class="grid gap-3 border-t border-line py-5 md:grid-cols-[220px_1fr] md:items-center">
                    <div>
                        <p class="text-[14px] font-semibold text-ink">Max Search Distance</p>
                        <p class="mt-0.5 text-[13px] text-stone">Only suggest places within range</p>
                    </div>
                    <div class="flex max-w-[420px] items-center gap-4">
                        <input type="range" min="1" max="20" class="range-slider h-1.5 flex-1 appearance-none rounded-full bg-line"
                               @bind="State.MaxRadiusKm" @bind:event="oninput" />
                        <span class="w-16 rounded-lg border border-line bg-paper py-1 text-center font-mono text-sm text-ink">@State.MaxRadiusKm km</span>
                    </div>
                </div>

                <!-- Spicy Filter -->
                <div class="grid gap-3 border-t border-line py-5 md:grid-cols-[220px_1fr] md:items-center">
                    <div>
                        <p class="text-[14px] font-semibold text-ink">Spice Filter</p>
                        <p class="mt-0.5 text-[13px] text-stone">Skip dishes marked hot</p>
                    </div>
                    <div class="flex max-w-[420px] items-center justify-between gap-4 rounded-xl border border-line px-4 py-3">
                        <span class="flex items-center gap-2.5 text-[14px] text-ink">
                            <Icons Name="flame" Class="text-tangerine" /> Always exclude spicy by default
                        </span>
                        <div class="switch-track @(State.ExcludeSpicyDefault ? "on" : "")"
                             @onclick="() => State.ExcludeSpicyDefault = !State.ExcludeSpicyDefault">
                            <div class="switch-thumb"></div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Card 3: History & Stored Data (Restored Section) -->
            <section class="rounded-2xl border border-line bg-white p-7 shadow-card">
                <div class="mb-5">
                    <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-stone">Stored Data</p>
                    <h2 class="mt-1 font-serif text-[24px] font-medium text-ink">History &amp; <em class="italic">Stored Data</em></h2>
                    <p class="mt-1 text-sm text-stone">Manage cached spins and bookmarks associated with this account.</p>
                </div>

                <div class="divide-y divide-line rounded-xl border border-line">
                    <!-- Spin History Row -->
                    <div class="flex flex-wrap items-center justify-between gap-4 px-5 py-4">
                        <div>
                            <p class="text-[14px] font-semibold text-ink">Recent Spin Log</p>
                            <p class="mt-0.5 text-[13px] text-stone">
                                @(State.SpinCount > 0 ? $"{State.SpinCount} spins recorded in this session" : "No spins recorded")
                            </p>
                        </div>
                        <button class="h-10 rounded-full border border-line px-4 text-sm font-semibold text-ink transition hover:border-ink disabled:opacity-40"
                                disabled="@(State.SpinCount == 0)"
                                @onclick="ClearSpinHistory">
                            Clear Spin History
                        </button>
                    </div>

                    <!-- Bookmarks Row -->
                    <div class="flex flex-wrap items-center justify-between gap-4 px-5 py-4">
                        <div>
                            <p class="text-[14px] font-semibold text-ink">Bookmarked Meals</p>
                            <p class="mt-0.5 text-[13px] text-stone">
                                @(State.BookmarksCount > 0 ? $"{State.BookmarksCount} saved dishes" : "No saved dishes")
                            </p>
                        </div>
                        <button class="h-10 rounded-full border border-line px-4 text-sm font-semibold text-ink transition hover:border-ink disabled:opacity-40"
                                disabled="@(State.BookmarksCount == 0)"
                                @onclick="ResetBookmarks">
                            Reset Saved Dishes
                        </button>
                    </div>
                </div>
            </section>
        </div>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        if (!State.IsAuthenticated) Nav.NavigateTo("/auth");
    }

    private void ToggleDiet(string d)
    {
        if (State.DietaryRestrictions.Contains(d)) State.DietaryRestrictions.Remove(d);
        else State.DietaryRestrictions.Add(d);
        State.NotifyChanged();
    }

    private void ClearSpinHistory()
    {
        State.SpinCount = 0;
        State.NotifyChanged();
    }

    private void ResetBookmarks()
    {
        State.BookmarksCount = 0;
        State.NotifyChanged();
    }

    private void Logout()
    {
        State.IsAuthenticated = false;
        State.NotifyChanged();
        Nav.NavigateTo("/auth");
    }
}