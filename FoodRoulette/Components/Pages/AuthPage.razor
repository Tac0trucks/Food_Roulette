@page "/auth"
@rendermode InteractiveServer
@inject FoodRouletteApp.Models.AppState State
@inject NavigationManager Nav

<div style="min-height: 100vh; display: grid; place-items: center; padding: 2.5rem 1rem;">
    <main style="width: 100%; max-width: 440px;">
        <div class="card" style="padding: 2rem; border-radius: 1.5rem; box-shadow: var(--shadow-modal);">
            <header style="display: flex; flex-direction: column; align-items: center; text-align: center;">
                <span style="width: 48px; height: 48px; border-radius: 16px; background: var(--color-ink); color: #fff; display: grid; place-items: center;">
                    <FoodRoulette.Shared.Icons Name="dice" />
                </span>
                <h1 style="margin-top: 1rem; font-size: 26px; font-weight: 800; letter-spacing: -0.02em; color: var(--color-ink);">FoodRoulette</h1>
                <p class="font-serif" style="margin-top: 4px; font-size: 17px; font-style: italic; color: var(--color-stone);">Decide what to eat without the debate.</p>
            </header>

            <!-- Mode Switcher -->
            <div style="margin-top: 1.75rem; display: grid; grid-template-columns: 1fr 1fr; gap: 4px; background: var(--color-paper); padding: 4px; border-radius: 9999px; border: 1px solid var(--color-line);">
                <button type="button" class="pill-btn @(mode == "in" ? "active" : "")" style="height: 40px; justify-content: center;" @onclick='() => mode = "in"'>Sign In</button>
                <button type="button" class="pill-btn @(mode == "up" ? "active" : "")" style="height: 40px; justify-content: center;" @onclick='() => mode = "up"'>Create Account</button>
            </div>

            <!-- Form -->
            <form @onsubmit="HandleSubmit" style="margin-top: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
                @if (mode == "up")
                {
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px;">Full Name</label>
                        <div class="input-wrapper">
                            <FoodRoulette.Shared.Icons Name="user" />
                            <input @bind="fullName" placeholder="John Doe" required />
                        </div>
                    </div>
                }

                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px;">Email Address</label>
                    <div class="input-wrapper">
                        <FoodRoulette.Shared.Icons Name="mail" />
                        <input type="email" @bind="email" placeholder="john@example.com" required />
                    </div>
                </div>

                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px;">Password</label>
                    <div class="input-wrapper">
                        <FoodRoulette.Shared.Icons Name="lock" />
                        <input type="password" @bind="password" placeholder="At least 8 characters" required />
                    </div>
                </div>

                <button type="submit" class="btn-primary" style="height: 48px; width: 100%; font-size: 15px; margin-top: 8px;">
                    @(mode == "in" ? "Sign In to FoodRoulette" : "Create Free Account")
                </button>
            </form>
        </div>

        <p style="margin-top: 1.25rem; text-align: center; font-size: 12px; color: var(--color-stone);">
            By continuing, you agree to our <a href="#" style="color: var(--color-ink); text-decoration: underline;">Terms of Service</a>.
        </p>
    </main>
</div>

@code {
    private string mode = "in";
    private string fullName = "John Doe";
    private string email = "john@example.com";
    private string password = "password123";

    private void HandleSubmit()
    {
        State.IsAuthenticated = true;
        State.Email = email;
        if (mode == "up" && !string.IsNullOrWhiteSpace(fullName))
        {
            State.DisplayName = fullName;
        }
        State.NotifyChanged();
        Nav.NavigateTo("/");
    }
}