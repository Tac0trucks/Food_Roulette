@page "/auth"
@rendermode InteractiveServer
@inject FoodRouletteApp.Models.AppState State
@inject NavigationManager Nav

<div class="grid min-h-screen place-items-center bg-paper bg-[radial-gradient(900px_500px_at_85%_-10%,#E6F1E8_0%,transparent_60%),radial-gradient(700px_450px_at_-10%_110%,#FDEBDB_0%,transparent_55%)] px-4 py-10">
    <main class="w-full max-w-[440px]">
        <div class="rounded-3xl border border-line bg-white p-6 shadow-[0_10px_30px_rgba(0,0,0,.06)] sm:p-8">
            <header class="flex flex-col items-center text-center">
                <span class="grid size-12 place-items-center rounded-2xl bg-ink text-white">
                    <Icons Name="dice" />
                </span>
                <h1 class="mt-4 text-[26px] font-extrabold tracking-[-0.02em] text-ink">FoodRoulette</h1>
                <p class="mt-1 font-serif text-[17px] italic text-stone">Decide what to eat without the debate.</p>
            </header>

            <!-- Mode Switcher -->
            <div role="tablist" class="mt-7 grid grid-cols-2 gap-1 rounded-full border border-line bg-paper p-1">
                <button type="button" @onclick='() => mode = "in"'
                        class="h-10 rounded-full text-sm font-semibold transition @(mode == "in" ? "bg-matcha text-white shadow-[0_4px_12px_rgba(21,128,61,.22)]" : "text-stone hover:text-ink")">
                    Sign In
                </button>
                <button type="button" @onclick='() => mode = "up"'
                        class="h-10 rounded-full text-sm font-semibold transition @(mode == "up" ? "bg-matcha text-white shadow-[0_4px_12px_rgba(21,128,61,.22)]" : "text-stone hover:text-ink")">
                    Create Account
                </button>
            </div>

            <!-- Form -->
            <form @onsubmit="HandleSubmit" class="mt-6 flex flex-col gap-4">
                @if (mode == "up")
                {
                    <div>
                        <label class="mb-1.5 block text-[13px] font-semibold text-ink">Full Name</label>
                        <div class="flex h-12 items-center gap-2.5 rounded-xl border border-line bg-white px-3.5 text-stone transition focus-within:border-matcha focus-within:text-matcha focus-within:ring-4 focus-within:ring-matcha/10">
                            <Icons Name="user" />
                            <input class="h-full min-w-0 flex-1 bg-transparent text-[15px] text-ink outline-none placeholder:text-stone/60"
                                   placeholder="John Doe" @bind="fullName" required />
                        </div>
                    </div>
                }

                <div>
                    <label class="mb-1.5 block text-[13px] font-semibold text-ink">Email Address</label>
                    <div class="flex h-12 items-center gap-2.5 rounded-xl border border-line bg-white px-3.5 text-stone transition focus-within:border-matcha focus-within:text-matcha focus-within:ring-4 focus-within:ring-matcha/10">
                        <Icons Name="mail" />
                        <input type="email" class="h-full min-w-0 flex-1 bg-transparent text-[15px] text-ink outline-none placeholder:text-stone/60"
                               placeholder="john@example.com" @bind="email" required />
                    </div>
                </div>

                <div>
                    <label class="mb-1.5 block text-[13px] font-semibold text-ink">Password</label>
                    <div class="flex h-12 items-center gap-2.5 rounded-xl border border-line bg-white px-3.5 text-stone transition focus-within:border-matcha focus-within:text-matcha focus-within:ring-4 focus-within:ring-matcha/10">
                        <Icons Name="lock" />
                        <input type="password" class="h-full min-w-0 flex-1 bg-transparent text-[15px] text-ink outline-none placeholder:text-stone/60"
                               placeholder="At least 8 characters" @bind="password" required />
                    </div>
                </div>

                <div class="flex items-center justify-between text-[13.5px]">
                    <label class="flex cursor-pointer items-center gap-2 text-ink">
                        <input type="checkbox" checked class="size-4 rounded accent-matcha" />
                        Remember me
                    </label>
                    <a href="#" class="font-semibold text-matcha underline-offset-4 hover:underline">Forgot Password?</a>
                </div>

                <button type="submit"
                        class="mt-1 flex h-12 items-center justify-center gap-2 rounded-full bg-matcha text-[15px] font-semibold text-white transition hover:bg-matcha-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-matcha">
                    @(mode == "in" ? "Sign In to FoodRoulette" : "Create Free Account")
                </button>
            </form>
        </div>

        <p class="mt-5 text-center text-xs text-stone">
            By continuing, you agree to our <a href="#" class="font-medium text-ink underline underline-offset-2">Terms of Service</a>.
        </p>
    </main>
</div>

@code {
    private string mode = "in";
    private string fullName = "John Doe";
    private string email = "john@example.com";
    private string password = "password123";

    private void HandleSubmit()
    {
        State.IsAuthenticated = true;
        State.Email = email;
        if (mode == "up" && !string.IsNullOrWhiteSpace(fullName))
        {
            State.DisplayName = fullName;
        }
        State.NotifyChanged();
        Nav.NavigateTo("/");
    }
}