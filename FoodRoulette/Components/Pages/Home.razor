@page "/"
@rendermode InteractiveServer
@inject FoodRouletteApp.Models.AppState State
@inject NavigationManager Nav

<div style="min-height: 100vh;">
    <!-- Top bar -->
    <header class="navbar-container">
        <a href="/" style="display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--color-ink);">
            <span style="width: 36px; height: 36px; border-radius: 10px; background: var(--color-ink); color: #fff; display: grid; place-items: center;">
                <FoodRoulette.Shared.Icons Name="dice" />
            </span>
            <span style="font-size: 19px; font-weight: 800; letter-spacing: -0.02em;">FoodRoulette</span>
        </a>
        <nav style="display: flex; align-items: center; gap: 12px;">
            <button class="btn-primary" style="height: 40px; padding: 0 18px; font-size: 14px;">
                <FoodRoulette.Shared.Icons Name="plus" /> Add Custom Dish
            </button>
            <button class="btn-outline" style="height: 40px; padding: 0 18px; font-size: 14px;">
                <FoodRoulette.Shared.Icons Name="bookmark" /> Saved Meals
            </button>
            <button @onclick='() => Nav.NavigateTo("/settings")' style="width: 40px; height: 40px; border-radius: 50%; color: var(--color-stone); display: grid; place-items: center;">
                <FoodRoulette.Shared.Icons Name="gear" />
            </button>
            <button @onclick='() => Nav.NavigateTo("/profile")' class="btn-outline" style="height: 40px; padding: 4px 12px 4px 4px; display: flex; align-items: center; gap: 8px;">
                <span style="width: 32px; height: 32px; border-radius: 50%; background: var(--color-matcha-wash); color: var(--color-matcha); font-size: 12px; font-weight: 700; display: grid; place-items: center;">@State.Initials</span>
                <span style="font-size: 14px; font-weight: 600;">@State.DisplayName</span>
            </button>
        </nav>
    </header>

    <main style="max-width: 1440px; margin: 0 auto; padding: 8px 32px 40px; display: grid; grid-template-columns: 380px 1fr; gap: 24px;">
        <!-- Left: Preferences -->
        <aside class="card" style="padding: 28px; height: fit-content;">
            <p class="font-mono" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-matcha);">Step 01 · Preferences</p>
            <h2 class="font-serif" style="font-size: 32px; font-weight: 500; margin-top: 8px; line-height: 1.05;">Set Your <em style="font-style: italic;">Cravings</em></h2>
            <p style="font-size: 14px; color: var(--color-stone); margin-top: 8px;">Tune the wheel to your mood. We'll only spin dishes that fit.</p>

            <div style="height: 1px; background: var(--color-line); margin: 24px 0;"></div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; font-size: 13px; font-weight: 600; text-transform: uppercase; margin-bottom: 8px;">Budget</label>
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;">
                    @for (int b = 1; b <= 3; b++)
                    {
                        var budgetLevel = b;
                        <button class="pill-btn @(currentBudget == budgetLevel ? "active" : "") font-mono" style="height: 44px; justify-content: center; font-size: 15px;" @onclick="() => currentBudget = budgetLevel">
                            @(new string('$', budgetLevel))
                        </button>
                    }
                </div>
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 13px; font-weight: 600; text-transform: uppercase; margin-bottom: 8px;">Dining Type</label>
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; background: var(--color-paper); padding: 4px; border-radius: 9999px; border: 1px solid var(--color-line);">
                    @foreach (var dt in new[] { "Quick Bite", "Dine-In", "Delivery" })
                    {
                        <button class="pill-btn @(currentDining == dt ? "active" : "")" style="height: 36px; justify-content: center;" @onclick="() => currentDining = dt">
                            @dt
                        </button>
                    }
                </div>
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 13px; font-weight: 600; text-transform: uppercase; margin-bottom: 8px;">Cuisine</label>
                <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                    @foreach (var c in allCuisines)
                    {
                        var isSelected = selectedCuisines.Contains(c);
                        <button class="pill-btn @(isSelected ? "active-subtle" : "")" style="height: 32px; padding: 0 12px;" @onclick="() => ToggleCuisine(c)">
                            @if (isSelected)
                            {
                                <FoodRoulette.Shared.Icons Name="check" />
                            }
                            @c
                        </button>
                    }
                </div>
            </div>

            <button class="btn-primary" style="height: 48px; width: 100%; font-size: 15px; margin-top: 8px;" @onclick="Spin">
                <FoodRoulette.Shared.Icons Name="refresh" Class="@(spinning ? "animate-spin" : "")" /> @(spinning ? "Spinning..." : "Decide For Me!")
            </button>
        </aside>

        <!-- Right: Decision Card -->
        <section style="display: flex; flex-direction: column; gap: 24px;">
            <div class="card" style="display: grid; grid-template-columns: 1.05fr 1fr; overflow: hidden;">
                <div style="position: relative; min-height: 320px; background: var(--color-matcha-wash);">
                    <img src="@($"https://images.unsplash.com/photo-{activeDish.ImgId}?w=800&h=700&fit=crop&auto=format")" alt="@activeDish.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                    <span class="font-mono" style="position: absolute; top: 20px; left: 20px; border-radius: 9999px; background: rgba(255,255,255,0.95); padding: 6px 12px; font-size: 11px; text-transform: uppercase; font-weight: 600;">Tonight's Pick</span>
                </div>
                <div style="padding: 32px; display: flex; flex-direction: column;">
                    <p class="font-mono" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-tangerine);">Step 02 · The Spin</p>
                    <h1 class="font-serif" style="font-size: 46px; font-weight: 500; line-height: 1; margin-top: 12px;">@activeDish.Name</h1>
                    <p style="font-size: 15px; color: var(--color-stone); margin-top: 12px;">at <strong style="color: var(--color-ink);">@activeDish.Place</strong> · @activeDish.Cuisine</p>

                    <dl style="display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); padding: 16px 0; margin-top: 24px;">
                        <div>
                            <dt style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--color-stone);">Price</dt>
                            <dd class="font-mono" style="font-size: 17px; margin-top: 4px;">@(new string('$', activeDish.Budget))</dd>
                        </div>
                        <div style="border-left: 1px solid var(--color-line); padding-left: 16px;">
                            <dt style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--color-stone);">Ready In</dt>
                            <dd class="font-mono" style="font-size: 17px; margin-top: 4px;">@activeDish.Mins min</dd>
                        </div>
                        <div style="border-left: 1px solid var(--color-line); padding-left: 16px;">
                            <dt style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--color-stone);">Distance</dt>
                            <dd class="font-mono" style="font-size: 17px; margin-top: 4px;">@activeDish.Dist</dd>
                        </div>
                    </dl>

                    <div style="margin-top: auto; display: flex; gap: 12px; padding-top: 28px;">
                        <button class="btn-primary" style="height: 48px; flex: 1;" @onclick="Spin">Spin Again</button>
                        <button class="btn-outline" style="height: 48px; padding: 0 20px;">Directions</button>
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>

@code {
    private int currentBudget = 2;
    private string currentDining = "Dine-In";
    private List<string> selectedCuisines = new() { "Japanese", "Thai", "Korean" };
    private string[] allCuisines = { "Japanese", "Italian", "Mexican", "Thai", "Indian", "Mediterranean", "Korean", "American" };
    private bool spinning = false;

    private List<FoodRouletteApp.Models.DishItem> dishes = new()
    {
        new() { Name = "Tonkotsu Ramen", Place = "Menya Kōji", Cuisine = "Japanese", Budget = 2, Mins = 25, Dist = "0.8 mi", ImgId = "1569718212165-3a8278d5f624" },
        new() { Name = "Al Pastor Tacos", Place = "Taquería Luz", Cuisine = "Mexican", Budget = 1, Mins = 15, Dist = "0.4 mi", ImgId = "1565299585323-38d6b0865b47" },
        new() { Name = "Cacio e Pepe", Place = "Osteria Nove", Cuisine = "Italian", Budget = 3, Mins = 40, Dist = "2.1 mi", ImgId = "1473093295043-cdd812d0e601" }
    };
    private FoodRouletteApp.Models.DishItem activeDish = new();

    protected override void OnInitialized()
    {
        if (!State.IsAuthenticated)
        {
            Nav.NavigateTo("/auth");
            return;
        }

        currentBudget = State.DefaultBudget;
        currentDining = State.DefaultDining;
        activeDish = dishes[0];
    }

    private void ToggleCuisine(string c)
    {
        if (selectedCuisines.Contains(c)) selectedCuisines.Remove(c);
        else selectedCuisines.Add(c);
    }

    private async Task Spin()
    {
        spinning = true;
        await Task.Delay(400);
        activeDish = dishes[Random.Shared.Next(dishes.Count)];
        spinning = false;
    }
}