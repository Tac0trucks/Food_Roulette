@page "/"
@rendermode InteractiveServer
@using FoodRoulette.Models
@inject FoodRouletteApp.Models.AppState State
@inject NavigationManager Nav

<div class="min-h-screen bg-paper bg-[radial-gradient(1200px_600px_at_85%_-10%,#E6F1E8_0%,transparent_60%),radial-gradient(800px_500px_at_-10%_110%,#FDEBDB_0%,transparent_55%)]">
    <!-- Navbar -->
    <header class="mx-auto flex h-[76px] max-w-[1440px] items-center justify-between px-8">
        <a href="/" class="flex items-center gap-2.5 text-ink">
            <span class="grid size-9 place-items-center rounded-[10px] bg-ink text-white"><Icons Name="dice" /></span>
            <span class="text-[19px] font-extrabold tracking-[-0.02em]">FoodRoulette</span>
        </a>
        <nav class="flex items-center gap-3">
            <!-- Working Add Custom Dish Trigger -->
            <button @onclick="OpenAddModal" class="flex h-10 items-center gap-1.5 rounded-full bg-matcha px-4 text-sm font-semibold text-white transition hover:bg-matcha-deep">
                <Icons Name="plus" /> Add Custom Dish
            </button>
            <button class="flex h-10 items-center gap-1.5 rounded-full border border-line bg-white px-4 text-sm font-semibold text-ink transition hover:border-matcha">
                <Icons Name="bookmark" /> Saved Meals (@State.BookmarksCount)
            </button>
            <a href="/settings" class="grid size-10 place-items-center rounded-full text-stone transition hover:bg-white hover:text-ink">
                <Icons Name="gear" />
            </a>
            <a href="/profile" class="flex h-10 items-center gap-2 rounded-full border border-line bg-white py-1 pl-1 pr-3 transition hover:border-stone/40">
                <span class="grid size-8 place-items-center rounded-full bg-matcha-wash text-xs font-bold text-matcha">@State.Initials</span>
                <span class="text-sm font-semibold text-ink">@State.DisplayName</span>
            </a>
        </nav>
    </header>

    <!-- Main Workspace -->
    <main class="mx-auto grid max-w-[1440px] grid-cols-1 gap-6 px-8 pb-10 pt-2 lg:grid-cols-[380px_1fr]">
        <!-- Left: Filters Panel (Driven by New Enums) -->
        <aside class="h-fit rounded-2xl border border-line bg-white p-7 shadow-card">
            <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-matcha">Preferences</p>
            <h2 class="mt-2 font-serif text-[32px] font-medium leading-[1.05] tracking-[-0.01em] text-ink">Set Your <em class="italic">Cravings</em></h2>
            <p class="mt-2 text-sm leading-relaxed text-stone">Tune the wheel to your mood. We'll only spin dishes that fit.</p>

            <div class="my-6 h-px bg-line"></div>

            <!-- Budget Filter using BudgetTier Enum -->
            <div class="mb-5">
                <div class="mb-3 flex items-baseline justify-between">
                    <h3 class="text-[13px] font-semibold uppercase tracking-[0.08em] text-ink">Budget</h3>
                    <span class="font-mono text-[11px] text-stone">per person</span>
                </div>
                <div class="grid grid-cols-3 gap-2">
                    @foreach (BudgetTier tier in Enum.GetValues<BudgetTier>())
                    {
                        var lvl = (int)tier;
                        <button class="h-11 rounded-full border font-mono text-[15px] font-medium transition @(selectedBudgetTier == tier ? "border-matcha bg-matcha text-white shadow-[0_4px_12px_rgba(21,128,61,.22)]" : "border-line bg-white text-ink hover:border-stone/50")"
                                @onclick="() => selectedBudgetTier = tier">
                            @(new string('$', lvl))
                        </button>
                    }
                </div>
            </div>

            <!-- Dining Type using DiningType Enum -->
            <div class="mb-5">
                <h3 class="mb-3 text-[13px] font-semibold uppercase tracking-[0.08em] text-ink">Dining Type</h3>
                <div class="grid grid-cols-3 gap-1 rounded-full border border-line bg-paper p-1">
                    @foreach (DiningType mode in Enum.GetValues<DiningType>())
                    {
                        var modeLabel = mode switch {
                            DiningType.QuickBite => "Quick Bite",
                            DiningType.DineIn => "Dine-In",
                            DiningType.Delivery => "Delivery",
                            _ => mode.ToString()
                        };
                        <button class="flex h-9 items-center justify-center gap-1.5 rounded-full text-[13px] font-semibold transition @(selectedDiningType == mode ? "bg-matcha text-white shadow-sm" : "text-stone hover:text-ink")"
                                @onclick="() => selectedDiningType = mode">
                            @modeLabel
                        </button>
                    }
                </div>
            </div>

            <!-- Cuisines using CuisineType Enum (Now includes Filipino, Korean, etc.) -->
            <div class="mb-5">
                <div class="mb-3 flex items-baseline justify-between">
                    <h3 class="text-[13px] font-semibold uppercase tracking-[0.08em] text-ink">Cuisines</h3>
                    <span class="font-mono text-[11px] text-stone">@selectedCuisines.Count selected</span>
                </div>
                <div class="flex flex-wrap gap-2">
                    @foreach (CuisineType cuisine in Enum.GetValues<CuisineType>())
                    {
                        if (cuisine == CuisineType.Other) continue;
                        var on = selectedCuisines.Contains(cuisine);
                        <button class="flex h-8 items-center gap-1 rounded-full border px-3 text-[13px] font-medium transition @(on ? "border-matcha bg-matcha-wash text-matcha font-semibold" : "border-line text-ink hover:border-stone/50")"
                                @onclick="() => ToggleCuisine(cuisine)">
                            @if (on) { <Icons Name="check" /> } @cuisine.ToString()
                        </button>
                    }
                </div>
            </div>

            <div class="mt-8 flex items-center justify-between border-t border-line pt-5">
                <button @onclick="ResetFilters" class="text-sm font-medium text-stone underline-offset-4 hover:text-ink hover:underline">Reset</button>
                <span class="font-mono text-[11px] text-stone">@GetMatchingDishes().Count dishes match</span>
            </div>
        </aside>

        <!-- Right: The Decision Spin Stage -->
        <section class="flex flex-col gap-6">
            <div class="grid overflow-hidden rounded-2xl border border-line bg-white shadow-card xl:grid-cols-[1.05fr_1fr]">
                <div class="relative min-h-[320px] bg-matcha-wash">
                    <img src="@(activeDish.ImageUrl)" alt="@activeDish.Name"
                         class="absolute inset-0 size-full object-cover transition duration-500 @(spinning ? "scale-105 opacity-0 blur-sm" : "opacity-100")" />
                    <span class="absolute left-5 top-5 rounded-full bg-white/95 px-3 py-1.5 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink">Tonight's pick</span>
                </div>
                <div class="flex flex-col p-8">
                    <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-tangerine">The spin</p>
                    <div class="transition duration-300 @(spinning ? "translate-y-1 opacity-30" : "")">
                        <h1 class="mt-3 font-serif text-[48px] font-medium leading-[0.98] tracking-[-0.02em] text-ink">@activeDish.Name</h1>
                        <p class="mt-3 text-[15px] text-stone">at <span class="font-semibold text-ink">@activeDish.RestaurantName</span> · @activeDish.Cuisine</p>

                        <dl class="mt-6 grid grid-cols-3 border-y border-line py-4">
                            <div>
                                <dt class="text-[11px] font-semibold uppercase tracking-[0.08em] text-stone">Price</dt>
                                <dd class="mt-1 font-mono text-[17px] text-ink">@(new string('$', (int)activeDish.Budget))</dd>
                            </div>
                            <div class="border-l border-line pl-4">
                                <dt class="text-[11px] font-semibold uppercase tracking-[0.08em] text-stone">Ready In</dt>
                                <dd class="mt-1 font-mono text-[17px] text-ink">@activeDish.PrepMinutes min</dd>
                            </div>
                            <div class="border-l border-line pl-4">
                                <dt class="text-[11px] font-semibold uppercase tracking-[0.08em] text-stone">Distance</dt>
                                <dd class="mt-1 font-mono text-[17px] text-ink">@activeDish.DistanceKm km</dd>
                            </div>
                        </dl>
                    </div>

                    <div class="mt-auto flex gap-3 pt-7">
                        <button @onclick="Spin" disabled="@spinning"
                                class="flex h-12 flex-1 items-center justify-center gap-2 rounded-full bg-matcha text-[15px] font-semibold text-white transition hover:bg-matcha-deep disabled:opacity-80">
                            <Icons Name="refresh" Class="@(spinning ? "animate-spin" : "")" />
                            @(spinning ? "Spinning…" : "Spin Again")
                        </button>
                        <button @onclick="BookmarkCurrent" class="grid size-12 place-items-center rounded-full border border-line text-stone transition hover:border-tangerine hover:text-tangerine">
                            <Icons Name="bookmark" />
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Modal: Add Custom Dish -->
    @if (showAddModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4 backdrop-blur-sm">
            <div class="w-full max-w-[500px] rounded-3xl border border-line bg-white p-6 shadow-2xl">
                <div class="flex items-center justify-between pb-4 border-b border-line">
                    <h3 class="font-serif text-2xl font-medium text-ink">Add <em class="italic">Custom Dish</em></h3>
                    <button @onclick="() => showAddModal = false" class="text-stone hover:text-ink text-xl font-bold">✕</button>
                </div>
                
                <form @onsubmit="SaveCustomDish" class="mt-4 flex flex-col gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-ink mb-1">Dish Name</label>
                        <input class="w-full h-10 px-3 border border-line rounded-xl outline-none focus:border-matcha" @bind="newDish.Name" required />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-ink mb-1">Restaurant / Place</label>
                        <input class="w-full h-10 px-3 border border-line rounded-xl outline-none focus:border-matcha" @bind="newDish.RestaurantName" required />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-ink mb-1">Cuisine</label>
                            <select class="w-full h-10 px-3 border border-line rounded-xl outline-none focus:border-matcha bg-white" @bind="newDish.Cuisine">
                                @foreach (CuisineType c in Enum.GetValues<CuisineType>())
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-ink mb-1">Budget Tier</label>
                            <select class="w-full h-10 px-3 border border-line rounded-xl outline-none focus:border-matcha bg-white" @bind="newDish.Budget">
                                <option value="@BudgetTier.Budget">$ (Budget)</option>
                                <option value="@BudgetTier.Moderate">$$ (Moderate)</option>
                                <option value="@BudgetTier.Premium">$$$ (Premium)</option>
                            </select>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-ink mb-1">Ready Time (mins)</label>
                            <input type="number" min="5" max="120" class="w-full h-10 px-3 border border-line rounded-xl outline-none focus:border-matcha" @bind="newDish.PrepMinutes" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-ink mb-1">Distance (km)</label>
                            <input type="number" step="0.1" min="0.1" max="50" class="w-full h-10 px-3 border border-line rounded-xl outline-none focus:border-matcha" @bind="newDish.DistanceKm" />
                        </div>
                    </div>

                    <div class="mt-4 flex justify-end gap-2 pt-3 border-t border-line">
                        <button type="button" @onclick="() => showAddModal = false" class="h-10 px-4 rounded-full border border-line text-sm font-semibold text-stone hover:border-ink">Cancel</button>
                        <button type="submit" class="h-10 px-5 rounded-full bg-matcha text-sm font-semibold text-white hover:bg-matcha-deep">Add Dish</button>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@code {
    private BudgetTier selectedBudgetTier = BudgetTier.Moderate;
    private DiningType selectedDiningType = DiningType.DineIn;
    private HashSet<CuisineType> selectedCuisines = new() { CuisineType.Filipino, CuisineType.Japanese, CuisineType.Thai, CuisineType.Mexican, CuisineType.Italian };
    private bool spinning = false;
    private bool showAddModal = false;

    // Entity representation reflecting your new models
    public class DishViewModel
    {
        public string Name { get; set; } = "";
        public string RestaurantName { get; set; } = "";
        public CuisineType Cuisine { get; set; } = CuisineType.Filipino;
        public BudgetTier Budget { get; set; } = BudgetTier.Moderate;
        public DiningType Dining { get; set; } = DiningType.DineIn;
        public int PrepMinutes { get; set; } = 20;
        public double DistanceKm { get; set; } = 1.0;
        public string ImageUrl { get; set; } = "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=800&fit=crop";
    }

    private DishViewModel activeDish = new();
    private DishViewModel newDish = new();

    private List<DishViewModel> catalog = new()
    {
        new() { Name = "Crispy Pork Sisig", RestaurantName = "Manam Comfort Filipino", Cuisine = CuisineType.Filipino, Budget = BudgetTier.Moderate, PrepMinutes = 18, DistanceKm = 0.5, ImageUrl = "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=800&fit=crop" },
        new() { Name = "Tonkotsu Ramen", RestaurantName = "Menya Kōji", Cuisine = CuisineType.Japanese, Budget = BudgetTier.Moderate, PrepMinutes = 25, DistanceKm = 1.3, ImageUrl = "https://images.unsplash.com/photo-1569718212165-3a8278d5f624?w=800&fit=crop" },
        new() { Name = "Khao Soi", RestaurantName = "Baan Suan", Cuisine = CuisineType.Thai, Budget = BudgetTier.Moderate, PrepMinutes = 30, DistanceKm = 1.9, ImageUrl = "https://images.unsplash.com/photo-1559314809-0d155014e29e?w=800&fit=crop" },
        new() { Name = "Al Pastor Tacos", RestaurantName = "Taquería Luz", Cuisine = CuisineType.Mexican, Budget = BudgetTier.Budget, PrepMinutes = 15, DistanceKm = 0.6, ImageUrl = "https://images.unsplash.com/photo-1565299585323-38d6b0865b47?w=800&fit=crop" },
        new() { Name = "Cacio e Pepe", RestaurantName = "Osteria Nove", Cuisine = CuisineType.Italian, Budget = BudgetTier.Premium, PrepMinutes = 40, DistanceKm = 3.4, ImageUrl = "https://images.unsplash.com/photo-1473093295043-cdd812d0e601?w=800&fit=crop" }
    };

    protected override void OnInitialized()
    {
        selectedBudgetTier = (BudgetTier)State.DefaultBudget;
        if (catalog.Count > 0) activeDish = catalog[0];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !State.IsAuthenticated)
        {
            await Task.Yield();
            Nav.NavigateTo("/auth");
        }
    }

    private List<DishViewModel> GetMatchingDishes()
    {
        return catalog
            .Where(d => selectedCuisines.Contains(d.Cuisine) && (int)d.Budget <= (int)selectedBudgetTier)
            .ToList();
    }

    private void ToggleCuisine(CuisineType c)
    {
        if (selectedCuisines.Contains(c)) selectedCuisines.Remove(c);
        else selectedCuisines.Add(c);
    }

    private void ResetFilters()
    {
        selectedBudgetTier = (BudgetTier)State.DefaultBudget;
        selectedCuisines = new() { CuisineType.Filipino, CuisineType.Japanese, CuisineType.Thai, CuisineType.Mexican, CuisineType.Italian };
    }

    private async Task Spin()
    {
        var match = GetMatchingDishes();
        if (!match.Any()) match = catalog;

        spinning = true;
        State.SpinCount++;
        await Task.Delay(400);
        activeDish = match[Random.Shared.Next(match.Count)];
        spinning = false;
    }

    private void BookmarkCurrent()
    {
        State.BookmarksCount++;
        State.NotifyChanged();
    }

    private void OpenAddModal()
    {
        newDish = new DishViewModel();
        showAddModal = true;
    }

    private void SaveCustomDish()
    {
        if (!string.IsNullOrWhiteSpace(newDish.Name))
        {
            catalog.Insert(0, newDish);
            activeDish = newDish;
            if (!selectedCuisines.Contains(newDish.Cuisine))
            {
                selectedCuisines.Add(newDish.Cuisine);
            }
            showAddModal = false;
        }
    }
}