@page "/"
@rendermode InteractiveServer
@inject FoodRouletteApp.Models.AppState State
@inject NavigationManager Nav

<div class="min-h-screen bg-paper bg-[radial-gradient(1200px_600px_at_85%_-10%,#E6F1E8_0%,transparent_60%),radial-gradient(800px_500px_at_-10%_110%,#FDEBDB_0%,transparent_55%)]">
    <!-- Navbar -->
    <header class="mx-auto flex h-[76px] max-w-[1440px] items-center justify-between px-8">
        <a href="/" class="flex items-center gap-2.5 text-ink">
            <span class="grid size-9 place-items-center rounded-[10px] bg-ink text-white"><FoodRoulette.Shared.Icons Name="dice" /></span>
            <span class="text-[19px] font-extrabold tracking-[-0.02em]">FoodRoulette</span>
        </a>
        <nav class="flex items-center gap-3">
            <button class="flex h-10 items-center gap-1.5 rounded-full bg-matcha px-4 text-sm font-semibold text-white transition hover:bg-matcha-deep">
                <FoodRoulette.Shared.Icons Name="plus" /> Add Custom Dish
            </button>
            <button class="flex h-10 items-center gap-1.5 rounded-full border border-line bg-white px-4 text-sm font-semibold text-ink transition hover:border-matcha">
                <FoodRoulette.Shared.Icons Name="bookmark" /> Saved Meals (@State.BookmarksCount
            </button>
            <a href="/settings" class="grid size-10 place-items-center rounded-full text-stone transition hover:bg-white hover:text-ink">
                <FoodRoulette.Shared.Icons Name="gear" />
            </a>
            <a href="/profile" class="flex h-10 items-center gap-2 rounded-full border border-line bg-white py-1 pl-1 pr-3 transition hover:border-stone/40">
                <span class="grid size-8 place-items-center rounded-full bg-matcha-wash text-xs font-bold text-matcha">@State.Initials</span>
                <span class="text-sm font-semibold text-ink">@State.DisplayName</span>
            </a>
        </nav>
    </header>

    <!-- Main -->
    <main class="mx-auto grid max-w-[1440px] grid-cols-1 gap-6 px-8 pb-10 pt-2 lg:grid-cols-[380px_1fr]">
        <!-- Left: Filters Panel -->
        <aside class="h-fit rounded-2xl border border-line bg-white p-7 shadow-card">
            <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-matcha">Step 01 · Preferences</p>
            <h2 class="mt-2 font-serif text-[32px] font-medium leading-[1.05] tracking-[-0.01em] text-ink">Set Your <em class="italic">Cravings</em></h2>
            <p class="mt-2 text-sm leading-relaxed text-stone">Tune the wheel to your mood. We'll only spin dishes that fit.</p>

            <div class="my-6 h-px bg-line"></div>

            <div class="mb-5">
                <div class="mb-3 flex items-baseline justify-between">
                    <h3 class="text-[13px] font-semibold uppercase tracking-[0.08em] text-ink">Budget</h3>
                    <span class="font-mono text-[11px] text-stone">per person</span>
                </div>
                <div class="grid grid-cols-3 gap-2">
                    @for (int b = 1; b <= 3; b++)
                    {
                        var lvl = b;
                        <button class="h-11 rounded-full border font-mono text-[15px] font-medium transition @(currentBudget == lvl ? "border-matcha bg-matcha text-white shadow-[0_4px_12px_rgba(21,128,61,.22)]" : "border-line bg-white text-ink hover:border-stone/50")"
                                @onclick="() => currentBudget = lvl">
                            @(new string('$', lvl))
                        </button>
                    }
                </div>
            </div>

            <div class="mb-5">
                <h3 class="mb-3 text-[13px] font-semibold uppercase tracking-[0.08em] text-ink">Dining Type</h3>
                <div class="grid grid-cols-3 gap-1 rounded-full border border-line bg-paper p-1">
                    @foreach (var dt in new[] { "Quick Bite", "Dine-In", "Delivery" })
                    {
                        <button class="flex h-9 items-center justify-center gap-1.5 rounded-full text-[13px] font-semibold transition @(currentDining == dt ? "bg-matcha text-white shadow-sm" : "text-stone hover:text-ink")"
                                @onclick="() => currentDining = dt">
                            @dt
                        </button>
                    }
                </div>
            </div>

            <div class="mb-5">
                <div class="mb-3 flex items-baseline justify-between">
                    <h3 class="text-[13px] font-semibold uppercase tracking-[0.08em] text-ink">Cuisines</h3>
                    <span class="font-mono text-[11px] text-stone">@selectedCuisines.Count selected</span>
                </div>
                <div class="flex flex-wrap gap-2">
                    @foreach (var c in allCuisines)
                    {
                        var on = selectedCuisines.Contains(c);
                        <button class="flex h-8 items-center gap-1 rounded-full border px-3 text-[13px] font-medium transition @(on ? "border-matcha bg-matcha-wash text-matcha font-semibold" : "border-line text-ink hover:border-stone/50")"
                                @onclick="() => ToggleCuisine(c)">
                            @if (on) { <FoodRoulette.Shared.Icons Name="check" /> } @c
                        </button>
                    }
                </div>
            </div>

            <div class="mt-8 flex items-center justify-between border-t border-line pt-5">
                <button @onclick="ResetFilters" class="text-sm font-medium text-stone underline-offset-4 hover:text-ink hover:underline">Reset</button>
                <span class="font-mono text-[11px] text-stone">@GetMatchingDishes().Count dishes match</span>
            </div>
        </aside>

        <!-- Right: The Decision Spin Stage -->
        <section class="flex flex-col gap-6">
            <div class="grid overflow-hidden rounded-2xl border border-line bg-white shadow-card xl:grid-cols-[1.05fr_1fr]">
                <div class="relative min-h-[320px] bg-matcha-wash">
                    <img src="@($"https://images.unsplash.com/photo-{activeDish.ImgId}?w=800&h=700&fit=crop&auto=format")" alt="@activeDish.Name"
                         class="absolute inset-0 size-full object-cover transition duration-500 @(spinning ? "scale-105 opacity-0 blur-sm" : "opacity-100")" />
                    <span class="absolute left-5 top-5 rounded-full bg-white/95 px-3 py-1.5 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink">Tonight's pick</span>
                </div>
                <div class="flex flex-col p-8">
                    <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-tangerine">Step 02 · The spin</p>
                    <div class="transition duration-300 @(spinning ? "translate-y-1 opacity-30" : "")">
                        <h1 class="mt-3 font-serif text-[48px] font-medium leading-[0.98] tracking-[-0.02em] text-ink">@activeDish.Name</h1>
                        <p class="mt-3 text-[15px] text-stone">at <span class="font-semibold text-ink">@activeDish.Place</span> · @activeDish.Cuisine</p>

                        <dl class="mt-6 grid grid-cols-3 border-y border-line py-4">
                            <div>
                                <dt class="text-[11px] font-semibold uppercase tracking-[0.08em] text-stone">Price</dt>
                                <dd class="mt-1 font-mono text-[17px] text-ink">@(new string('$', activeDish.Budget))</dd>
                            </div>
                            <div class="border-l border-line pl-4">
                                <dt class="text-[11px] font-semibold uppercase tracking-[0.08em] text-stone">Ready In</dt>
                                <dd class="mt-1 font-mono text-[17px] text-ink">@activeDish.Mins min</dd>
                            </div>
                            <div class="border-l border-line pl-4">
                                <dt class="text-[11px] font-semibold uppercase tracking-[0.08em] text-stone">Distance</dt>
                                <dd class="mt-1 font-mono text-[17px] text-ink">@activeDish.Dist</dd>
                            </div>
                        </dl>
                    </div>

                    <div class="mt-auto flex gap-3 pt-7">
                        <button @onclick="Spin" disabled="@spinning"
                                class="flex h-12 flex-1 items-center justify-center gap-2 rounded-full bg-matcha text-[15px] font-semibold text-white transition hover:bg-matcha-deep disabled:opacity-80">
                            <FoodRoulette.Shared.Icons Name="refresh" Class="@(spinning ? "animate-spin" : "")" />
                            @(spinning ? "Spinning…" : "Spin Again")
                        </button>
                        <button @onclick="BookmarkCurrent" class="grid size-12 place-items-center rounded-full border border-line text-stone transition hover:border-tangerine hover:text-tangerine">
                            <FoodRoulette.Shared.Icons Name="bookmark" />
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>

@code {
    private int currentBudget = 2;
    private string currentDining = "Dine-In";
    private List<string> selectedCuisines = new() { "Japanese", "Thai", "Mexican", "Italian" };
    private string[] allCuisines = { "Japanese", "Thai", "Mexican", "Italian", "Korean", "American" };
    private bool spinning = false;

    private List<FoodRouletteApp.Models.DishItem> catalog = new()
    {
        new() { Name = "Tonkotsu Ramen", Place = "Menya Kōji", Cuisine = "Japanese", Budget = 2, Mins = 25, Dist = "0.8 mi", ImgId = "1569718212165-3a8278d5f624" },
        new() { Name = "Khao Soi", Place = "Baan Suan", Cuisine = "Thai", Budget = 2, Mins = 30, Dist = "1.2 mi", ImgId = "1559314809-0d155014e29e" },
        new() { Name = "Al Pastor Tacos", Place = "Taquería Luz", Cuisine = "Mexican", Budget = 1, Mins = 15, Dist = "0.4 mi", ImgId = "1565299585323-38d6b0865b47" },
        new() { Name = "Cacio e Pepe", Place = "Osteria Nove", Cuisine = "Italian", Budget = 3, Mins = 40, Dist = "2.1 mi", ImgId = "1473093295043-cdd812d0e601" }
    };

    private FoodRouletteApp.Models.DishItem activeDish = new();

    protected override void OnInitialized()
    {
        if (!State.IsAuthenticated)
        {
            Nav.NavigateTo("/auth", forceLoad: true);
            return;
        }
        currentBudget = State.DefaultBudget;
        currentDining = State.DefaultDining;
        activeDish = catalog[0];
    }

    private List<FoodRouletteApp.Models.DishItem> GetMatchingDishes()
    {
        return catalog
            .Where(d => selectedCuisines.Contains(d.Cuisine) && d.Budget <= currentBudget)
            .ToList();
    }

    private void ToggleCuisine(string c)
    {
        if (selectedCuisines.Contains(c)) selectedCuisines.Remove(c);
        else selectedCuisines.Add(c);
    }

    private void ResetFilters()
    {
        currentBudget = State.DefaultBudget;
        currentDining = State.DefaultDining;
        selectedCuisines = new() { "Japanese", "Thai", "Mexican", "Italian" };
    }

    private async Task Spin()
    {
        var match = GetMatchingDishes();
        if (!match.Any()) match = catalog;

        spinning = true;
        State.SpinCount++;
        await Task.Delay(450);
        activeDish = match[Random.Shared.Next(match.Count)];
        spinning = false;
    }

    private void BookmarkCurrent()
    {
        State.BookmarksCount++;
        State.NotifyChanged();
    }
}